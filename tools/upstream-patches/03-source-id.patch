diff --git a/scripts/tests/api/test_memory_client.py b/scripts/tests/api/test_memory_client.py
index a3f0474..f6d2eb0 100644
--- a/scripts/tests/api/test_memory_client.py
+++ b/scripts/tests/api/test_memory_client.py
@@ -511,3 +511,75 @@ def test_delete_where_narrows_by_a_type_it_recognises(client, monkeypatch):
     assert filters["source_type"] == "conversation"
     with pytest.raises(ValueError):
         client.delete_where(namespace="ns-a", source_type="not-a-type")
+
+
+# ---------------------------------------------------------------------------
+# ingest: the source_id the pipeline was already taking
+# ---------------------------------------------------------------------------
+
+def _capture_ingest(monkeypatch, report=None, derived="derived-from-content"):
+    import llm_memoryd.ingest_mid.ingest as ingest
+
+    seen = {}
+
+    def _fake(**kwargs):
+        seen.update(kwargs)
+        # The real pipeline always reports the id it used — the override if it
+        # got one, otherwise whatever the adapter derived.
+        body = {"source_id": kwargs.get("source_id") or derived}
+        body.update(report or {})
+        return body
+
+    monkeypatch.setattr(ingest, "ingest_source_agentic", _fake)
+    return seen
+
+
+def test_ingest_forwards_an_explicit_source_id(client, tmp_path, monkeypatch):
+    """`ingest_source_agentic` has taken a source_id all along; the facade could
+    not say "use this id" to it. A caller that keys its own registry by some id
+    needs the rows keyed by the same id or it cannot address them later."""
+    source = tmp_path / "card.json"
+    source.write_text('{"item_id": "inner-id"}\n', encoding="utf-8")
+    seen = _capture_ingest(monkeypatch)
+    out = client.ingest(str(source), "ai_research", namespace="ns-test",
+                        source_id="2401.01234v2")
+    assert seen["source_id"] == "2401.01234v2"
+    assert out["source_id"] == "2401.01234v2"
+    assert out["source_type"] == "ai_research"
+
+
+def test_ingest_without_an_override_leaves_the_derivation_alone(client, tmp_path, monkeypatch):
+    source = tmp_path / "card.json"
+    source.write_text('{"item_id": "inner-id"}\n', encoding="utf-8")
+    seen = _capture_ingest(monkeypatch)
+    out = client.ingest(str(source), "ai_research", namespace="ns-test")
+    assert seen["source_id"] is None, "omitting it must not invent a value"
+    assert out["source_id"] == "derived-from-content", \
+        "the answer is the id the rows landed under, not a guess about it"
+
+
+def test_the_facade_falls_back_to_the_id_it_asked_for(client, tmp_path, monkeypatch):
+    """A pipeline report that does not carry the id (an older report shape)
+    must not cost the caller the answer they already supplied.
+    """
+    source = tmp_path / "card.json"
+    source.write_text("{}\n", encoding="utf-8")
+    _capture_ingest(monkeypatch, report={"source_id": None})
+    out = client.ingest(str(source), "ai_research", namespace="ns-test",
+                        source_id="2401.01234v2")
+    assert out["source_id"] == "2401.01234v2"
+
+
+def test_ingest_refuses_a_source_id_nothing_could_address(client, tmp_path, monkeypatch):
+    """A source_id is only worth having if the read/delete side can filter on
+    it, and that filter goes through the store's id grammar. Accepting it here
+    would write rows whose only failure mode is 'deleted 0' two weeks later."""
+    source = tmp_path / "card.json"
+    source.write_text("{}\n", encoding="utf-8")
+    _capture_ingest(monkeypatch)
+    for bad in ("two words", "quote'x", "", "   ", "x" * 200):
+        try:
+            client.ingest(str(source), "ai_research", namespace="ns-test", source_id=bad)
+        except ValueError:
+            continue
+        raise AssertionError(f"{bad!r} was accepted as a source id")
