+    # ------------------------------------------------------------------
+    # delete side
+    # ------------------------------------------------------------------
+    def delete(self, memory_id: str, *, namespace: Optional[str] = None) -> Dict[str, Any]:
+        """Forget one row, by id.
+
+        Why the library owns this rather than leaving it to the caller: every
+        other write and read a consuming repository does goes through this
+        class, and a delete is the one mutation where skipping the layer costs
+        the most — below it live the id grammar that keeps a string out of a
+        SQL filter, and the store lock that keeps a delete from interleaving
+        with an ingest. Handing out `VectorStore` to callers is how a second,
+        ungarded delete path appears in a downstream repo.
+
+        * `memory_id` is checked against the store's own grammar here, before a
+          lock is acquired, so a caller with a bad id list gets the same error
+          whether or not anything was found to delete.
+        * `namespace=`, when given, is an assertion about the row rather than a
+          filter: a row that turns out to live somewhere else is a refusal, not
+          a silent success. A stale id list is the realistic way to hit this,
+          and "deleted nothing because you named the wrong scope" is the answer
+          that can be trusted.
+        * Nothing is derived from `cwd`. Derivation is the read side's
+          convenience; on this side a guess is a scope change.
+        """
+        vs = _resolve("common.vector")
+        if vs is None:
+            raise ValueError("llm_memoryd.common.vector is not available")
+        ident = _checked_id(vs, memory_id, "memory id")
+        named = _checked_namespace(namespace) if namespace is not None else None
+        store = vs.VectorStore(self._store_dir, self._config)
+        with store_lock():
+            row = store.get_by_ids([ident]).get(ident)
+            if row is None:
+                # Not an error: the caller asked for a state, and the store
+                # already satisfies it. Reporting it beats raising, because the
+                # common cause (an id that was already dropped by a re-ingest)
+                # is not something the caller did wrong.
+                return {"deleted": False, "memory_id": ident, "namespace": named,
+                        "reason": "no row with this id"}
+            if named is not None and (row.get("namespace") or "") != named:
+                raise ValueError(
+                    f"refusing to delete: memory id {ident!r} is in namespace "
+                    f"{(row.get('namespace') or '')!r}, not {named!r}")
+            store.delete(ident)
+        return {"deleted": True, "memory_id": ident, "namespace": named}
+
+    def delete_where(self, *, namespace: Optional[str] = None,
+                     source_id: Optional[str] = None,
+                     source_type: Optional[str] = None,
+                     tier: Optional[str] = None,
+                     dry_run: bool = False) -> Dict[str, Any]:
+        """Delete one explicit scope in a single commit, reporting the count.
+
+        The store already refuses an unscoped delete, so this method's job is
+        to be the stricter of the two — `VectorStore.delete_where()` accepts
+        *either* a concrete namespace or a concrete `source_id`, and that is
+        right for a SELECT-shaped helper but too loose for a library entry
+        point: a source id is a per-project string, so `source_id="main"` with
+        no namespace would match rows from every project on the machine. Here
+        the namespace is required and concrete, exactly as the UI's own
+        namespace/source handlers demand it.
+
+        One commit, not one per row (the P1-15 property the store was built
+        for): a namespace-sized delete costs the same whether it has ten rows
+        or ten thousand, which also means the delete is not visible halfway
+        through to a concurrent search.
+
+        `dry_run` reports `count_rows` against the *same* filter expression the
+        commit would use, so it is a preview of this call rather than a
+        different query. Nothing is deleted under it, but the lock is still
+        taken: a count that changes under you is not a preview.
+        """
+        vs = _resolve("common.vector")
+        if vs is None:
+            raise ValueError("llm_memoryd.common.vector is not available")
+        named = _checked_namespace(namespace)
+        src = str(source_id or "").strip()
+        if src == "*":
+            raise ValueError("refusing to delete source_id='*': pass one exact source_id")
+        if src:
+            _checked_id(vs, src, "source id")
+        if source_type is not None and str(source_type) not in SOURCE_TYPES:
+            raise ValueError("unsupported source_type")
+        store = vs.VectorStore(self._store_dir, self._config)
+        with store_lock():
+            if dry_run:
+                removed = store.count_rows(named, tier=tier, source_type=source_type,
+                                           source_id=src or None)
+            else:
+                removed = store.delete_where(named, tier=tier, source_type=source_type,
+                                             source_id=src or None)
+        return {"namespace": named, "source_id": src or None,
+                "source_type": source_type, "tier": tier, "dry_run": bool(dry_run),
+                "deleted": int(removed or 0)}
+
