+
+# ---------------------------------------------------------------------------
+# delete side
+#
+# The point of these cases is not that LanceDB can delete a row — test_vector.py
+# owns that. What is owned here is the boundary's behaviour: the id is checked
+# before anything is touched, a namespace the caller names is enforced rather
+# than ignored, and the store lock that ingest commits under is held.
+# ---------------------------------------------------------------------------
+
+def _row(mem_id, namespace="ns-a", source_id="src-1", source_type="conversation"):
+    """A row shaped like the store's own, so a delete path under test is not
+    talking to a schema the pipeline never writes."""
+    from datetime import datetime, timezone
+
+    now = datetime.now(timezone.utc).isoformat()
+    return {
+        "id": mem_id, "vector": [0.1] * 8, "namespace": namespace, "tier": "mid",
+        "memory_type": "semantic", "abstract": "abstract", "detail": "detail",
+        "abstracts_chain": "[]", "keywords": '["k"]', "importance": 0.5,
+        "access_count": 0, "last_accessed_at": "", "created_at": now,
+        "tier_updated_at": now, "source": "test", "session_id": "",
+        "occurred_at": "", "source_id": source_id, "source_type": source_type,
+    }
+
+
+def _store(client):
+    pytest.importorskip("lancedb")
+    from llm_memoryd.common.vector import VectorStore
+
+    return VectorStore(client.store_dir, CONFIG)
+
+
+def _spied_store(monkeypatch, sink, rows=None, reported=2):
+    """A VectorStore that records what the facade asked it to do.
+
+    Patched where the library resolves it, for the same reason the search
+    recorder is: one place left to stub, so the fake cannot disagree with the
+    real call graph.
+    """
+    import contextlib
+
+    import llm_memoryd.common.vector as vector
+    import llm_memoryd.api as memory_api
+
+    class _Spy:
+        def __init__(self, *args, **kwargs):
+            sink.append("store")
+
+        def get_by_ids(self, ids):
+            sink.append(("get_by_ids", tuple(ids)))
+            return {i: r for i, r in (rows or {}).items() for r in [rows[i]]}
+
+        def delete(self, memory_id):
+            sink.append(("delete", memory_id))
+
+        def delete_where(self, namespace, **filters):
+            sink.append(("delete_where", namespace, filters))
+            return reported
+
+        def count_rows(self, namespace, **filters):
+            sink.append(("count_rows", namespace, filters))
+            return reported
+
+    @contextlib.contextmanager
+    def _lock(*args, **kwargs):
+        sink.append("lock")
+        try:
+            yield
+        finally:
+            sink.append("unlock")
+
+    monkeypatch.setattr(vector, "VectorStore", _Spy)
+    monkeypatch.setattr(memory_api, "store_lock", _lock)
+    return sink
+
+
+def _order(sink, names):
+    """True when every name in `names` appears in `sink` in that order."""
+    index = 0
+    for entry in sink:
+        key = entry[0] if isinstance(entry, tuple) else entry
+        if key == names[index]:
+            index += 1
+            if index == len(names):
+                return True
+    return False
+
+
+def test_delete_removes_exactly_the_named_row(client):
+    pytest.importorskip("lancedb")
+    store = _store(client)
+    store.add(_row("keep-me"))
+    store.add(_row("drop-me"))
+
+    out = client.delete("drop-me", namespace="ns-a")
+    assert out["deleted"] is True
+    assert sorted(r["id"] for r in store.all_rows("ns-a")) == ["keep-me"]
+
+
+def test_delete_says_so_when_the_id_is_not_in_the_store(client):
+    """A caller with a stale id list did nothing wrong, so it is not told it
+    failed — "there was nothing at this id" is a result, not an exception."""
+    pytest.importorskip("lancedb")
+    _store(client).add(_row("only-row"))
+    out = client.delete("never-existed", namespace="ns-a")
+    assert out["deleted"] is False
+    assert "reason" in out
+    assert [r["id"] for r in _store(client).all_rows("ns-a")] == ["only-row"]
+
+
+def test_a_named_namespace_is_an_assertion_not_a_filter(client):
+    """The row lives in ns-a; naming ns-b is a wrong claim about the store, and
+    the answer is a refusal that leaves the row alone."""
+    pytest.importorskip("lancedb")
+    store = _store(client)
+    store.add(_row("ns-a-row"))
+    try:
+        client.delete("ns-a-row", namespace="ns-b")
+    except ValueError as exc:
+        assert "namespace" in str(exc)
+    else:
+        raise AssertionError("a cross-namespace delete was allowed through")
+    assert [r["id"] for r in store.all_rows("ns-a")] == ["ns-a-row"]
+
+
+def test_delete_rejects_an_id_the_store_could_not_filter_on(client):
+    pytest.importorskip("lancedb")
+    _store(client).add(_row("well-formed-id"))
+    for bad in ("", "   ", "two words", "../escape", "quote'here", "x" * 200):
+        try:
+            client.delete(bad, namespace="ns-a")
+        except ValueError:
+            continue
+        raise AssertionError(f"{bad!r} reached the store as an id")
+    assert [r["id"] for r in _store(client).all_rows("ns-a")] == ["well-formed-id"]
+
+
+def test_delete_where_refuses_every_unscoped_shape(client):
+    pytest.importorskip("lancedb")
+    store = _store(client)
+    store.add(_row("row-1"))
+    for kwargs in ({}, {"namespace": "*"}, {"namespace": ""}, {"namespace": "   "},
+                   {"namespace": ["*"]}, {"source_id": "src-1", "namespace": "*"}):
+        try:
+            client.delete_where(**kwargs)
+        except ValueError as exc:
+            assert "namespace" in str(exc), (kwargs, exc)
+        else:
+            raise AssertionError(f"unscoped delete accepted: {kwargs}")
+    assert [r["id"] for r in store.all_rows("ns-a")] == ["row-1"]
+
+
+def test_delete_where_deletes_only_the_named_source_and_reports_the_count(client):
+    pytest.importorskip("lancedb")
+    store = _store(client)
+    store.add(_row("a-1", source_id="src-1"))
+    store.add(_row("a-2", source_id="src-1"))
+    store.add(_row("a-3", source_id="src-2"))
+    store.add(_row("b-1", namespace="ns-b", source_id="src-1"))
+
+    out = client.delete_where(namespace="ns-a", source_id="src-1")
+    assert out["deleted"] == 2
+    assert out["namespace"] == "ns-a" and out["source_id"] == "src-1"
+    assert sorted(r["id"] for r in store.all_rows("ns-a")) == ["a-3"]
+    assert [r["id"] for r in store.all_rows("ns-b")] == ["b-1"]
+
+
+def test_the_delete_side_is_locked_the_way_the_write_side_is(client, monkeypatch):
+    """Same lock ingest commits under, taken before the read that decides what
+    to delete and not released until after the commit. A lock that arrives
+    after the read is a race the audit trail will not be able to explain.
+    """
+    sink = _spied_store(monkeypatch, [], rows={"id-1": _row("id-1")})
+    client.delete("id-1", namespace="ns-a")
+    assert _order(sink, ["lock", "get_by_ids", "delete", "unlock"]), sink
+
+    sink = _spied_store(monkeypatch, [])
+    client.delete_where(namespace="ns-a", source_id="src-1")
+    assert _order(sink, ["lock", "delete_where", "unlock"]), sink
+    call = [entry for entry in sink if isinstance(entry, tuple) and entry[0] == "delete_where"][0]
+    assert call[1] == "ns-a", "the namespace must arrive positionally-explicit, never as '*'"
+
+
+def test_dry_run_previews_the_exact_scope_it_would_delete(client, monkeypatch):
+    """`dry_run` counts against the same filter as the commit — but it still
+    takes the lock, because a count that moves under you is not a preview."""
+    sink = _spied_store(monkeypatch, [], reported=3)
+    out = client.delete_where(namespace="ns-a", source_id="src-1", dry_run=True)
+    assert out["dry_run"] is True and out["deleted"] == 3
+    assert not [entry for entry in sink if isinstance(entry, tuple)
+                and entry[0] == "delete_where"], sink
+    assert _order(sink, ["lock", "count_rows", "unlock"]), sink
+
+
+def test_delete_where_narrows_by_a_type_it_recognises(client, monkeypatch):
+    sink = _spied_store(monkeypatch, [], reported=1)
+    client.delete_where(namespace="ns-a", source_type="conversation")
+    filters = [entry for entry in sink if isinstance(entry, tuple)
+               and entry[0] == "delete_where"][0][2]
+    assert filters["source_type"] == "conversation"
+    with pytest.raises(ValueError):
+        client.delete_where(namespace="ns-a", source_type="not-a-type")
