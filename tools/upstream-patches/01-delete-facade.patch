+def _checked_id(vs, value: Any, label: str) -> str:
+    """The store's id grammar, applied at the boundary instead of at the filter.
+
+    Read off `vector.ID_RE` rather than re-declared here so the rule the delete
+    paths use cannot drift from the one every other write path already obeys.
+    A caller handing over an id it scraped from a URL, a JSON blob or a search
+    result is the normal case, and this is where a value that would otherwise
+    reach a quoted SQL clause is stopped.
+    """
+    text = str(value or "")
+    if not text.strip():
+        raise ValueError(f"{label} must be a non-empty string")
+    pattern = getattr(vs, "ID_RE", None)
+    if pattern is not None and not pattern.match(text):
+        raise ValueError(f"invalid {label}: {text[:80]!r}")
+    return text
+
+
+def _checked_namespace(namespace: Any) -> str:
+    """One concrete namespace name, or a refusal that explains itself.
+
+    `*` is the store's own "no namespace clause" marker and the empty string
+    arrives there by accident just as easily; for a SELECT either is a
+    convenience, for a DELETE both are the whole table. Same refusal text the
+    UI handlers give, so a caller pattern-matching on it keeps working.
+    """
+    text = str(namespace or "").strip()
+    if not text or text == "*":
+        raise ValueError("refusing to delete '*'/empty: pass one exact namespace name")
+    return text
+
+
 def _resolve(module: str):
     """The one place the library resolves one of its own submodules.
 
